            "description": "QUÉ HACER: apretar Send.\nQUÉ HACE: pide el historial como cliente, con límite de 2 consultas.\nQUÉ DEBE DAR: 200, un campo total y como máximo 2 consultas.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
