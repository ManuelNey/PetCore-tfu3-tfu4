    {
      "name": "5 - Exportación a PDF (eventos)",
      "item": [
        {
          "name": "5.1 - Pedir la exportación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La API acepta la solicitud (202)\", () => pm.response.to.have.status(202));",
                  "const j = pm.response.json();",
                  "pm.test(\"Estado PENDIENTE\", () => pm.expect(j.estado).to.eql(\"PENDIENTE\"));",
                  "pm.collectionVariables.set(\"id_tarea\", j.id_tarea);",
                  "pm.collectionVariables.set(\"intentos\", \"0\");"
                ]
              }
